"150" y="225" as="sourcePoint" /><mxPoint x="476" y="225" as="targetPoint" /></mxGeometry></mxCell><mxCell id="12" parent="1" vertex="1" value="1. PUT /me/task-recurrences/{id} với chu kỳ và phiên bản" style="whiteSpace=wrap;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=13;"><mxGeometry x="156" y="179" width="314" height="44" as="geometry" /></mxCell><mxCell id="13" parent="1" edge="1" style="endArrow=block;strokeColor=#385c81;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><mxPoint x="476" y="287" as="sourcePoint" /><mxPoint x="802" y="287" as="targetPoint" /></mxGeometry></mxCell><mxCell id="14" parent="1" vertex="1" value="2. Kiểm tra chủ việc và lưu lịch theo múi giờ của hạn" style="whiteSpace=wrap;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=13;"><mxGeometry x="482" y="241" width="314" height="44" as="geometry" /></mxCell><mxCell id="15" parent="1" edge="1" style="endArrow=block;strokeColor=#385c81;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"><mxPoint x="476" y="349" as="sourcePoint" /><mxPoint x="150" y="349" as="targetPoint" /></mxGeometry></mxCell><mxCell id="16" parent="1" vertex="1" value="3. Trả ngày của kỳ kế tiếp" style="whiteSpace=wrap;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=13;"><mxGeometry x="156" y="303" width="314" height="44" as="geometry" /></mxCell><mxCell id="17" parent="1" edge="1" style="endArrow=block;strokeColor=#385c81;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><mxPoint x="1128" y="411" as="sourcePoint" /><mxPoint x="802" y="411" as="targetPoint" /></mxGeometry></mxCell><mxCell id="18" parent="1" vertex="1" value="4. Khóa dòng lịch đến hạn, bỏ qua khóa đang bận" style="whiteSpace=wrap;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=13;"><mxGeometry x="808" y="365" width="314" height="44" as="geometry" /></mxCell><mxCell id="19" parent="1" edge="1" style="endArrow=block;strokeColor=#385c81;strokeWidth=2;"><mxGeometry relative="1" as="geometry"><mxPoin