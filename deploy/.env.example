# Copy to .env and replace every change-me value. Never commit .env.
#
# Public deployment: DOMAIN=app.example.com (DNS A/AAAA -> this server).
# Local HTTP smoke test: DOMAIN=:80 and HTTP_PORT=8088.
DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Ho_Chi_Minh

# Postgres (not published to the host).
POSTGRES_DB=smarttask
POSTGRES_USER=smarttask
POSTGRES_PASSWORD=change-me-postgres-long-random

# MinIO root is only used by the one-shot init container.
MINIO_ROOT_USER=smarttask-root
MINIO_ROOT_PASSWORD=change-me-minio-root-long-random
# Dedicated app user used by the backend (readwrite policy, not root).
MINIO_APP_USER=smarttask-app
MINIO_APP_PASSWORD=change-me-minio-app-long-random
MINIO_BUCKET=smarttask

# First boot: leave empty, register the admin in the UI, then set the
# username here and recreate the backend once. See DEPLOY.md.
BOOTSTRAP_ADMIN_USERNAME=
# true = users can self-register but stay PENDING until an admin approves.
SELF_REGISTRATION=true

# Only needed when the SPA is hosted on another origin (e.g. Vercel).
# Comma-separated exact origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

# Build-time SPA settings. VITE_API_BASE=/api/v1 works with the Caddy proxy.
VITE_API_BASE=/api/v1
# false hides the AI screen when no Ollama instance is deployed.
VITE_ENABLE_AI=true

# Optional: reach an Ollama server on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# JVM memory. Leave headroom for Postgres + MinIO + Caddy on a 4 GB VPS.
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseG1GC

# MinIO image override (community images are distributed via Bitnami Legacy).
# MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5
